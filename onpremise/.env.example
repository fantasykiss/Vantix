# ────────────────────────────────────────────
# Vantix On-Premise 환경변수 설정 파일
# 이 파일을 복사해서 .env 로 저장 후 값을 채워주세요
# cp .env.example .env
# ────────────────────────────────────────────

# Redmine 연결
REDMINE_URL=http://your-redmine-server
REDMINE_API_KEY=

# AI 기능 (Anthropic)
ANTHROPIC_API_KEY=

# 관리자 비밀번호
ADMIN_PASSWORD=

# 암호화 키 (Fernet) — 아래 명령으로 생성:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# 기본 프로젝트 설정
DEFAULT_PROJECT_ID=
DEFAULT_UPDATED_AFTER=2026-01-01

# 이메일 리포트 (선택사항)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_RECIPIENTS=

# 리포트 발송 스케줄 (기본: 매주 월요일 오전 9시)
REPORT_DAY=mon
REPORT_HOUR=9
REPORT_MINUTE=0
