# ── Redmine 연동 (필수) ──────────────────────────────
BASE_URL=https://redmine.example.com
API_KEY=your_redmine_api_key
REDMINE_PUBLIC_URL=            # 이슈 링크용 공개 URL (비우면 BASE_URL)

# ── DB (회원·결제·세션, Postgres) ────────────────────
# 비우면 파일 폴백 모드 (sessions.json). SaaS 기능엔 Postgres 필요.
DATABASE_URL=

# ── AI 인사이트 (선택) ──────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ── 세션 암호화 ─────────────────────────────────────
FERNET_KEY=                    # Fernet.generate_key() 결과

# ── 이메일 리포트 (선택) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_RECIPIENTS=            # 콤마 구분
REPORT_DAY=mon
REPORT_HOUR=9
REPORT_MINUTE=0

# ── 대시보드 기본값 ─────────────────────────────────
DEFAULT_PROJECT_ID=
DEFAULT_UPDATED_AFTER=2026-03-01

# ── 관리자 / 운영 ───────────────────────────────────
ADMIN_PASSWORD=
OWNER_IPS=127.0.0.1

# ── 결제 (포트원) — 베타 기간 비활성 ────────────────
PAYMENTS_ENABLED=false
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# ── 데모 모드 (선택) ────────────────────────────────
DEMO_URL=
DEMO_KEY=

# ── QA: 테스트 전용 DB (운영 DATABASE_URL 과 분리) ──
TEST_DATABASE_URL=
